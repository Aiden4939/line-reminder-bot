PORT=3000
TZ=Asia/Taipei

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

DB_HOST=db
DB_PORT=5432
DB_NAME=line_reminder
DB_USER=appuser
DB_PASSWORD=devpassword

# 可選：排程 cron 表達式，預設每分鐘執行
REMINDER_CRON=* * * * *

# OpenAI 自然語言解析（hybrid = 規則優先，失敗再用 LLM）
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
NLU_MODE=hybrid

# 查詢提醒時使用 Flex 卡片（false 改回純文字列表）
FLEX_LIST_ENABLED=true
